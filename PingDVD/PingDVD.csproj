<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>PingDVD</RootNamespace>
    <AssemblyName>PingDVD</AssemblyName>
    <ApplicationIcon>Assets/pingdvd.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <MacOSBundleInfoPlist>Info.plist</MacOSBundleInfoPlist>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <Content Include="Assets/pingdvd.icns">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Info.plist">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="StampMacExecutableIcon"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <_MacIconSource>$(MSBuildProjectDirectory)/Assets/pingdvd.png</_MacIconSource>
      <_MacIconResource>$(IntermediateOutputPath)pingdvd-icon.rsrc</_MacIconResource>
      <_MacExecutablePath>$(TargetDir)$(AssemblyName)$(_NativeExecutableExtension)</_MacExecutablePath>
    </PropertyGroup>

    <Exec Condition="Exists('$(_MacIconSource)')"
          Command="/usr/bin/sips -i &quot;$(_MacIconSource)&quot;" />
    <Exec Condition="Exists('$(_MacIconSource)')"
          Command="/usr/bin/DeRez -only icns &quot;$(_MacIconSource)&quot; &gt; &quot;$(_MacIconResource)&quot;" />
    <Exec Condition="Exists('$(_MacIconResource)') and Exists('$(_MacExecutablePath)')"
          Command="/usr/bin/Rez -append &quot;$(_MacIconResource)&quot; -o &quot;$(_MacExecutablePath)&quot;" />
    <Exec Condition="Exists('$(_MacIconResource)') and Exists('$(_MacExecutablePath)')"
          Command="/usr/bin/SetFile -a C &quot;$(_MacExecutablePath)&quot;" />
  </Target>

</Project>
